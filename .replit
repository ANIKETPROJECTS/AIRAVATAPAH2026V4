modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Port Redirect"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Kisan Mitra"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 BASE_PATH=/ pnpm --filter @workspace/agri-admin run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8000 MONGODB_DB=apnaapp NODE_ENV=development node --enable-source-maps artifacts/api-server/dist/index.mjs"
waitForPort = 8000

[[workflows.workflow]]
name = "Port Redirect"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/redirect-8080.mjs"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Kisan Mitra"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/kisan-mitra && ./node_modules/.bin/expo start --web --port 8008"
waitForPort = 8008

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8008
externalPort = 8008

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8099
externalPort = 8099

[[ports]]
localPort = 18593
externalPort = 3001

[[ports]]
localPort = 21926
externalPort = 3000

[userenv]

[userenv.shared]
MONGODB_DB = "apnaapp"
PORT = "5000"
API_PORT = "8000"
BASE_PATH = "/"

[nix]
channel = "stable-25_05"
