{
  "expo": {
    "name": "कृषी सुविधा",
    "slug": "kisan-mitra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#14532D"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agrimh.krishisuvidha"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14532D"
      },
      "package": "com.agrimh.krishisuvidha"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow कृषी सुविधा to access your photos to upload documents.",
          "cameraPermission": "Allow कृषी सुविधा to use your camera to capture documents."
        }
      ],
      "expo-document-picker",
      "expo-secure-store"
    ]
  }
}
